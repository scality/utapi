{
  "name": "utapi",
  "engines": {
    "node": ">=22"
  },
  "version": "8.3.1",
  "description": "API for tracking resource utilization and reporting metrics",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scality/utapi.git"
  },
  "author": "Scality",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/scality/utapi/issues"
  },
  "homepage": "https://github.com/scality/utapi#readme",
  "dependencies": {
    "@aws-sdk/client-iam": "^3.975.0",
    "@hapi/joi": "^17.1.1",
    "@scality/arsenal": "^8.6.0-0",
    "@scality/bucketclient": "scality/bucketclient#8.3.0",
    "@senx/warp10": "1.0.14",
    "async": "^3.2.6",
    "aws4": "^1.13.2",
    "backo": "^1.1.0",
    "body-parser": "^1.20.3",
    "byte-size": "^9.0.1",
    "commander": "^12.1.0",
    "cron-parser": "^4.9.0",
    "diskusage": "^1.2.0",
    "encoding-down": "^6.3.0",
    "express": "^4.21.2",
    "get-folder-size": "^2.0.1",
    "ioredis": "^5.4.2",
    "js-yaml": "^4.1.0",
    "level-mem": "^5.0.1",
    "levelup": "^4.3.2",
    "memdown": "^5.0.0",
    "needle": "^3.3.1",
    "node-schedule": "^2.1.1",
    "oas-tools": "^2.2.2",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.3",
    "vaultclient": "scality/vaultclient#8.5.9",
    "werelogs": "scality/werelogs#8.2.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "9.22.0",
    "@scality/eslint-config-scality": "scality/Guidelines#8.3.3",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-mocha": "^10.5.0",
    "mocha": "^10.7.3",
    "nodemon": "^3.1.9",
    "protobufjs": "^7.4.0",
    "sinon": "^19.0.2"
  },
  "scripts": {
    "ft_test": "mocha --recursive tests/functional --exit",
    "ft_test:client": "mocha --recursive tests/functional/client --exit",
    "ft_test:cron": "mocha --recursive tests/functional/cron --exit",
    "ft_test:interval": "mocha --recursive tests/functional/interval --exit",
    "ft_test:server": "mocha --recursive tests/functional/server --exit",
    "ft_test:v2": "mocha --recursive tests/functional/v2 --exit",
    "ft_test:softLimit": "mocha --recursive tests/functional/softLimit --exit",
    "ft_test:hardLimit": "mocha --recursive tests/functional/hardLimit --exit",
    "lint": "eslint $(git ls-files '*.js')",
    "lint_md": "mdlint $(git ls-files '*.md')",
    "start": "node server.js",
    "test": "mocha --recursive tests/unit --exit",
    "start_v2:task:ingest": "ENABLE_UTAPI_V2=1 node bin/ingestShards.js",
    "start_v2:task:checkpoint": "ENABLE_UTAPI_V2=1 node bin/createCheckpoint.js",
    "start_v2:task:snapshot": "ENABLE_UTAPI_V2=1 node bin/createSnapshot.js",
    "start_v2:task:repair": "ENABLE_UTAPI_V2=1 node bin/repair.js",
    "start_v2:task:reindex": "ENABLE_UTAPI_V2=1 node bin/reindex.js",
    "start_v2:task:migrate": "ENABLE_UTAPI_V2=1 node bin/migrate.js",
    "start_v2:task:disk": "ENABLE_UTAPI_V2=1 node bin/diskUsage.js",
    "start_v2:task:adjust": "ENABLE_UTAPI_V2=1 node bin/manualAdjust.js",
    "start_v2:server": "ENABLE_UTAPI_V2=1 node bin/server.js",
    "start_v2:server:dev": "UTAPI_DEV_MODE=t ENABLE_UTAPI_V2=t yarn nodemon --watch './**/*.js' --watch './**/*.json' --watch './**/*.yaml' --exec node bin/server.js"
  }
}
